# 统一换行符，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 这些必须保持二进制，别被当文本处理
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.exe    binary
*.dll    binary
*.sys    binary
*.cat    binary
*.zip    binary

# 批处理必须留 CRLF：cmd.exe 读 LF-only 的 .cmd/.bat 会在某些分支上出错
*.cmd    text eol=crlf
*.bat    text eol=crlf

# 文本类明确标一下（差异看得清楚）
*.ps1    text
*.md     text
*.json   text
*.inf    text

# 厂商文件原样保留，不做任何换行符转换 —— 改了就等于改了原厂包
src/driver/** -text
src/lib/**    -text
