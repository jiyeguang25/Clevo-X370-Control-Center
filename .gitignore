# ---- 构建产物（发布走 Releases，不进版本库）----
/dist/

# ---- 运行期产物：日志、状态快照、回滚记录、截图池 ----
/artifacts/
/state/
settings.json
show.request
*.log

# ---- 渲染脚本临时生成的运行副本（diag-render-ui.ps1 每次自己重建）----
src/_render-run.ps1

# ---- 本地探针脚本（验证用，不是产品的一部分）----
/_probe/

# ---- 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store

# 版面重排时按轮留下的源码备份（只在本地用）
src/*.bak-*
